pragma language_version 0.23;

import CompactStandardLibrary;

// A survey with a fixed, pre-committed roster of 8 members. Each member
// gets a secret key generated for them off-chain and never shares it —
// only its hash goes on the roster. Responding proves "I hold a key on
// this roster" without saying which one, and the same commitment doubles
// as its own one-time nullifier: once it's been used to respond, it can't
// be used again, but nothing about it points back to a specific member.
//
// The three response options are just tally counters. No individual
// response is ever stored — only which bucket grew by one — so there is
// nothing on the ledger to unlink from a person, because it was never
// linked in the first place.

export ledger memberCommitments: Set<Bytes<32>>;
export ledger usedCommitments: Set<Bytes<32>>;
export ledger tallyA: Counter;
export ledger tallyB: Counter;
export ledger tallyC: Counter;
export ledger responseCount: Counter;
export ledger revealThreshold: Uint<16>;

witness secretKey(): Bytes<32>;

constructor(
  member0: Bytes<32>,
  member1: Bytes<32>,
  member2: Bytes<32>,
  member3: Bytes<32>,
  member4: Bytes<32>,
  member5: Bytes<32>,
  member6: Bytes<32>,
  member7: Bytes<32>,
  threshold: Uint<16>,
) {
  memberCommitments.insert(disclose(member0));
  memberCommitments.insert(disclose(member1));
  memberCommitments.insert(disclose(member2));
  memberCommitments.insert(disclose(member3));
  memberCommitments.insert(disclose(member4));
  memberCommitments.insert(disclose(member5));
  memberCommitments.insert(disclose(member6));
  memberCommitments.insert(disclose(member7));
  revealThreshold = disclose(threshold);
}

circuit recordResponse(): Bytes<32> {
  const commitment = disclose(persistentHash<Vector<1, Bytes<32>>>([secretKey()]));
  assert(memberCommitments.member(commitment), "You're not on this survey's member list");
  assert(!usedCommitments.member(commitment), "You've already responded to this survey");
  usedCommitments.insert(commitment);
  responseCount.increment(1);
  return commitment;
}

export circuit respondA(): [] {
  recordResponse();
  tallyA.increment(1);
}

export circuit respondB(): [] {
  recordResponse();
  tallyB.increment(1);
}

export circuit respondC(): [] {
  recordResponse();
  tallyC.increment(1);
}
